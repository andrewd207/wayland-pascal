<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>wayland-client</name>
  <!-- version inherited from aggregator -->
  <author>Andrew Haines</author>
  <license>BSD-3-Clause</license>

  <!-- Aggregator for the client-side stack: the generated client-core proxies
       (rt), the protocol tiers, and the OOP convenience layer (classes). All
       build on the shared wayland-common transport. -->
  <build>
    <packaging>pom</packaging>
  </build>

  <modules>
    <module>rt</module>
    <module>stable</module>
    <module>unstable</module>
    <module>staging</module>
    <module>classes</module>
    <!-- FreeType glyph atlas for the accelerated canvas. Produces coverage
         (sfA8) CPU pages, so it serves the GL and software backends alike. -->
    <module activeByDefault="false">text</module>
    <!-- GPU canvas backend (EGL/GL). Not RTL-only, so it is excluded from the
         default build; nothing else in the stack depends on it. -->
    <module activeByDefault="false">gl</module>
    <!-- Retained widget toolkit on TwgCanvas; runs on either backend. -->
    <module activeByDefault="false">widgets</module>
  </modules>
</project>
